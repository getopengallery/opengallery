# OpenGallery server configuration.
#
# The setup in the browser (open the site, it leads to /setup) creates .env
# from this file. Copy it by hand only when installing on the command line.
#
# Only what the gallery needs before it can reach its database lives here.
# Everything else (site name, language, registration, public albums, e-mail,
# upload limits and file types, theme, plugins, activity log) is changed in the
# admin under Settings, Themes and Plugins.

APP_NAME=OpenGallery
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Other addresses of this site, comma-separated (www and non-www of APP_URL are included).
# GALLERY_TRUSTED_HOSTS=

# Initial default language (en, de); afterwards set in Admin → Settings.
# English is the source language, keep it as the fallback.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Production: MySQL/MariaDB. For quick local development you can use
# DB_CONNECTION=sqlite instead (and delete the other DB_* lines).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=opengallery
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# E-mail is set up in Admin -> Settings -> E-mail. This value is only used
# while "Server configuration" is chosen there (log = write mails to the log).
MAIL_MAILER=log

# --- OpenGallery -----------------------------------------------------------
GALLERY_MEDIA_DISK=gallery
# Set to true only if a queue worker (or cron-driven queue:work) is running.
GALLERY_QUEUE_CONVERSIONS=false
# Upload chunk size in KB; leave empty to derive it from the PHP upload limits.
GALLERY_UPLOAD_CHUNK_KB=

# Plugins that are always enabled (comma-separated folder names in /plugins).
GALLERY_PLUGINS=

# GitHub repository the update check reads. Leave it out for the official one;
# set it to nothing to rule out update checks on this server.
# GALLERY_UPDATE_REPOSITORY=getopengallery/opengallery
# Set to false so updates can only be installed by hand.
# GALLERY_UPDATE_INSTALL=true
