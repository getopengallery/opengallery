<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Compression and browser caching. Each block only applies where the host has
# the Apache module, so a missing module never breaks the site.

# Pages, styles and scripts are sent compressed (photos are compressed already).
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml
    </IfModule>
</IfModule>

<IfModule mod_setenvif.c>
    # Built files (public/build/assets) have a content hash in their name: they never change.
    SetEnvIf Request_URI "/build/assets/[^/]+$" OG_HASHED_ASSET
    # Admin panel files carry the Filament version in their address (?v=...).
    SetEnvIf Request_URI "/(css|js|fonts)/filament/" OG_VERSIONED_ASSET
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=OG_HASHED_ASSET
    Header set Cache-Control "public, max-age=604800" env=OG_VERSIONED_ASSET
</IfModule>
